{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",  
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "nodemon src/worker.js",
    "scheduler": "nodemon src/scheduler.js",
    "dev:all": "concurrently -k -n API,WORKER,SCHEDULER \"npm:dev\" \"npm:worker\" \"npm:scheduler\"",
    "start:prod": "pm2 start ecosystem.config.cjs --env production",
    "stop:prod": "pm2 stop ecosystem.config.cjs",
    "restart:prod": "pm2 restart ecosystem.config.cjs",
    "delete:prod": "pm2 delete ecosystem.config.cjs",
    "reload:prod": "pm2 reload ecosystem.config.cjs",
    "status:prod": "pm2 status",
    "logs:prod": "pm2 logs",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "pm2": "^7.1.2",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
